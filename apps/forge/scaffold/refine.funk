; refine — ONE fix step, gated on the DETERMINISTIC check (not an AI rating).
; Scaffold the plan, run funk check + the style gate: if it's CLEAN, the plan is
; returned unchanged (a no-op — this is what makes chaining safe); otherwise reflect
; on the real check errors + the connection review to produce a corrected plan.
; Chaining refine calls in `forge` gives a fix-until-green loop whose cap = the
; number of links in the chain — it keeps reflecting until `funk check` passes.
package "funk/forge" {
  version 0.1.0
  use "funk/std/strings" as strings
}

fn refine {
  name "Refine"
  doc """
    # Refine
    ### Scaffold a plan and, while `funk check` reports errors, reflect it into a corrected one.
  """
  examples """
    # Examples:
    (refine task plan "/tmp/out") → the same plan when check is clean, else a reflected plan
  """
  in  (task Str) (plan Json) (dir Str)
  out (revised Json)
      (clean Bool (doc "True When The Scaffolded Plan Passed Check"))
  body
    (let (d (scaffold (planFunctions plan) dir (planHeader plan)))
    (let (errs (strings.concat (checkGate d) (strings.concat "\n" (styleGate d))))
      (if (hasErrors errs)
        (flush (revised (pickPlan (reflect task plan errs "") plan)) (clean false))
        (flush (revised plan) (clean true)))))
}
