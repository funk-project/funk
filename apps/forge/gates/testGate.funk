; testGate — run `funk test` on a GENERATED project and return its failures
; (empty string when green). The INTENT net: the human's acceptance examples,
; translated by decompose into inline `test (is …)` assertions, become the
; convergence target — refine keeps reflecting until they pass, so a project
; converges on what the human MEANT, not merely on check-green. Modeled on
; checkGate (funk running funk: a python atom shells out to the CLI).
package "funk/forge" {
  version 0.1.0
}

fn testGate {
  name "Test Gate"
  doc """
    # Test Gate
    ### Run `funk test` on a generated project and return its failures (empty when green).
  """
  examples """
    # Examples:
    (testGate "/tmp/green") → ""
    (testGate "/tmp/red") → "FAIL main: got 3, want 4"
  """
  in  (dir Str)
  out (failures Str)
  engine python
  src """
    import subprocess, os, shutil, re, glob
    funk = os.environ.get('FUNK_BIN') or shutil.which('funk') or 'funk'
    # `funk test` runs EVERY loaded assertion (std is self-testing) and its FAIL
    # lines carry only the fn NAME — so collect THIS project's fn names and keep
    # only their failures (drop std's own results).
    names = set()
    for f in glob.glob(os.path.join(dir, '**', '*.funk'), recursive=True):
        try:
            with open(f) as fh:
                names.update(re.findall(r'^fn\s+(\w+)', fh.read(), re.M))
        except Exception:
            pass
    p = subprocess.run([funk, 'test', '-f', dir], capture_output=True, text=True, timeout=300)
    out = (p.stdout or '') + chr(10) + (p.stderr or '')
    keep = [l for l in out.splitlines()
            if l.startswith('FAIL ') and l[5:].split(':', 1)[0].strip() in names]
    # log the failure count per run so the fix-until-green loop is observable.
    # All runtime artefacts live under <project>/.agent-runner, never the root.
    try:
        import time
        ar = os.path.join(dir, '.agent-runner')
        os.makedirs(ar, exist_ok=True)
        with open(os.path.join(ar, 'forge-test-log'), 'a') as _f:
            _f.write(str(int(time.time())) + ' ' + str(len(keep)) + ' failures' + chr(10))
    except Exception:
        pass
    return chr(10).join(keep).strip()
    """
}
