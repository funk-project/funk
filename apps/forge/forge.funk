; funk/forge — a forge that writes funk, written IN funk.
;
; The `main` composes the pipeline from functions defined in SIBLING FILES (one
; function per file) so each is small (shallow nesting → no parenthesis wall),
; isolated, and testable in parallel with `funk test`. This is the dogfood:
; funk building funk.
package "funk/forge" {
  version 0.1.0
}

fn forge {
  main
  name "Forge"
  doc """
    # Forge
    ### Turn a plain-language task into a valid, style-conformant funk project that passes its own tests.
  """
  examples """
    # Examples:
    (forge "sum and mean of a list" "/tmp/stats" "") → "/tmp/stats"  ; writes main + lib/
    (forge "min and max of a list" "/tmp/mm" "(main [3,1,4]) → min 1 and max 4") → tests seeded from the intent
  """
  in  (task Str (doc "Plain-Language Task Description"))
      (dir Str (doc "Target Project Folder"))
      (intent Str (default "") (doc "Acceptance Examples — The Convergence Target"))
  out (path Str (doc "Generated Project Directory"))
  body
    ; NOTE: a multi-output let destructures BY NAME — the binding names must be
    ; the callee's out-port names (revised/clean), shadowed at each level. Binding
    ; them as r1/c1 silently yields nils (the old bug: the chain could never take
    ; an early exit and crashed the next refine on a nil plan).
    (let (p0 (decompose task intent))
    (let (revised clean (refine task p0 dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
    (let (revised clean (refine task revised dir))
    (if clean (flush (path dir))
      (do (funkTicket (diagnoseFunk (checkGate dir) (projectSource dir)) dir)
          (flush (path dir))))))))))))))))))))))))
}
