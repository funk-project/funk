; funk/std — stats (Python `statistics`)

package "funk/std/stats" {
  version 0.0.1
}

fn median {
  doc """
    # Median
    ### Middle value of a list; the mean of the two middle values when the count is even.
  """
  in  (xs List (doc "The list of numbers"))
  out (r Num (doc "The median value"))
  examples """
    - `(median [3, 1, 2])` → `2`
    - `(median [1, 2, 3, 4])` → `2.5`
  """
  engine python
  src """
    import statistics
    return statistics.median(xs)
  """
}

fn mode {
  doc """
    # Mode
    ### Most common value in a list.
  """
  in  (xs List (doc "The list of values"))
  out (r Any (doc "The value that appears most often"))
  examples """
    - `(mode [1, 1, 2, 3])` → `1`
    - `(mode [4, 4, 1, 2])` → `4`
  """
  engine python
  src """
    import statistics
    return statistics.mode(xs)
  """
}

fn variance {
  doc """
    # Variance
    ### Sample variance of a list of numbers (divides by `n - 1`).
  """
  in  (xs List (doc "The list of numbers"))
  out (r Num (doc "The sample variance"))
  examples """
    - `(variance [2, 4, 6])` → `4`
    - `(variance [1, 2, 3, 4, 5])` → `2.5`
  """
  engine python
  src """
    import statistics
    return statistics.variance(xs)
  """
}

fn stdev {
  doc """
    # Stdev
    ### Sample standard deviation — the square root of the sample `variance`.
  """
  in  (xs List (doc "The list of numbers"))
  out (r Num (doc "The sample standard deviation"))
  examples """
    - `(stdev [2, 4, 6])` → `2`
    - `(stdev [1, 2, 3, 4, 5])` → `1.581…`
  """
  engine python
  src """
    import statistics
    return statistics.stdev(xs)
  """
}

fn pmin {
  doc """
    # Pmin
    ### Smallest value in a list.
  """
  in  (xs List (doc "The list of numbers"))
  out (r Num (doc "The minimum value"))
  examples """
    - `(pmin [3, 1, 2])` → `1`
    - `(pmin [5, 9, 2, 7])` → `2`
  """
  engine python
  src """
    return min(xs)
  """
}

fn pmax {
  doc """
    # Pmax
    ### Largest value in a list.
  """
  in  (xs List (doc "The list of numbers"))
  out (r Num (doc "The maximum value"))
  examples """
    - `(pmax [3, 1, 2])` → `3`
    - `(pmax [5, 9, 2, 7])` → `9`
  """
  engine python
  src """
    return max(xs)
  """
}

fn range {
  doc """
    # Range
    ### Spread of a list — the difference between its largest and smallest values.
  """
  in  (xs List (doc "The list of numbers"))
  out (r Num (doc "`max(xs) - min(xs)`"))
  examples """
    - `(range [3, 1, 7, 2])` → `6`
    - `(range [5, 5])` → `0`
  """
  engine python
  src """
    return max(xs) - min(xs)
  """
}

fn percentile {
  doc """
    # Percentile
    ### The `p`-th percentile (0–100) of a list, using linear interpolation between adjacent ranks.
  """
  in  (p Num (doc "The percentile to compute, from 0 to 100"))
      (xs List (doc "The list of numbers"))
  out (r Num (doc "The value at the `p`-th percentile"))
  examples """
    - `(percentile 50 [1, 2, 3, 4])` → `2.5`
    - `(percentile 25 [1, 2, 3, 4, 5])` → `2`
  """
  engine python
  src """
    s = sorted(xs)
    if not s:
        return 0
    if len(s) == 1:
        return s[0]
    k = (len(s) - 1) * (p / 100.0)
    lo = int(k)
    hi = min(lo + 1, len(s) - 1)
    return s[lo] + (s[hi] - s[lo]) * (k - lo)
  """
}
