; funk/std — stats (Python `statistics`)

package "funk/std/stats" {
  version 0.0.1
  use "funk/std/collections" as collections
  use "funk/std/maths" as maths
}

fn median {
  name "Median"
  doc """
    # Median
    ### Middle value of a list; the mean of the two middle values when the count is even.
  """
  in  (xs (List Num) (doc "The list of numbers"))
  out (r Num (doc "The median value"))
  examples """
    - `(median [3, 1, 2])` → `2`
    - `(median [1, 2, 3, 4])` → `2.5`
  """
  engine python
  src "import statistics\nreturn statistics.median(xs)"
}

fn mode {
  name "Mode"
  doc """
    # Mode
    ### Most common value in a list.
  """
  in  (xs (List Num) (doc "The list of values"))
  out (r Any (doc "The value that appears most often"))
  examples """
    - `(mode [1, 1, 2, 3])` → `1`
    - `(mode [4, 4, 1, 2])` → `4`
  """
  engine python
  src "import statistics\nreturn statistics.mode(xs)"
}

fn variance {
  name "Variance"
  doc """
    # Variance
    ### Sample variance of a list of numbers (divides by `n - 1`).
  """
  in  (xs (List Num) (doc "The list of numbers"))
  out (r Num (doc "The sample variance"))
  examples """
    - `(variance [2, 4, 6])` → `4`
    - `(variance [1, 2, 3, 4, 5])` → `2.5`
  """
  engine python
  src "import statistics\nreturn statistics.variance(xs)"
}

fn stdev {
  name "Standard Deviation"
  doc """
    # Standard Deviation
    ### Sample standard deviation — the square root of the sample `variance`.
  """
  in  (xs (List Num) (doc "The list of numbers"))
  out (r Num (doc "The sample standard deviation"))
  examples """
    - `(stdev [2, 4, 6])` → `2`
    - `(stdev [1, 2, 3, 4, 5])` → `1.581…`
  """
  engine python
  src "import statistics\nreturn statistics.stdev(xs)"
}

fn pmin {
  name "Minimum"
  doc """
    # Minimum
    ### Smallest value in a list.
  """
  in  (xs (List Num) (doc "The list of numbers"))
  out (r Num (doc "The minimum value"))
  examples """
    - `(pmin [3, 1, 2])` → `1`
    - `(pmin [5, 9, 2, 7])` → `2`
  """
  engine python
  src "return min(xs)"
}

fn pmax {
  name "Maximum"
  doc """
    # Maximum
    ### Largest value in a list.
  """
  in  (xs (List Num) (doc "The list of numbers"))
  out (r Num (doc "The maximum value"))
  examples """
    - `(pmax [3, 1, 2])` → `3`
    - `(pmax [5, 9, 2, 7])` → `9`
  """
  engine python
  src "return max(xs)"
}

fn range {
  name "Range"
  doc """
    # Range
    ### Spread of a list — the difference between its largest and smallest values.
  """
  in  (xs (List Num) (doc "The list of numbers"))
  out (r Num (doc "`max(xs) - min(xs)`"))
  examples """
    - `(range [3, 1, 7, 2])` → `6`
    - `(range [5, 5])` → `0`
  """
  engine python
  src "return max(xs) - min(xs)"
}

fn percentile {
  name "Percentile"
  doc """
    # Percentile
    ### The `p`-th percentile (0–100) of a list, using linear interpolation between adjacent ranks.
  """
  in  (p Num (doc "The percentile to compute, from 0 to 100"))
      (xs (List Num) (doc "The list of numbers"))
  out (r Num (doc "The value at the `p`-th percentile"))
  examples """
    - `(percentile 50 [1, 2, 3, 4])` → `2.5`
    - `(percentile 25 [1, 2, 3, 4, 5])` → `2`
  """
  engine python
  src "s = sorted(xs)\nif not s:\n    return 0\nif len(s) == 1:\n    return s[0]\nk = (len(s) - 1) * (p / 100.0)\nlo = int(k)\nhi = min(lo + 1, len(s) - 1)\nreturn s[lo] + (s[hi] - s[lo]) * (k - lo)"
}

fn cv {
  name "Coefficient Of Variation"
  doc """
    # Coefficient Of Variation
    ### Standard deviation as a percentage of the mean — a scale-free measure of spread.
  """
  in  (xs (List Num) (doc "The sample of numbers"))
  out (r Num (doc "`stdev(xs) / mean(xs) * 100`"))
  examples """
    - `(cv (range 1 3))` → `50` (mean 2, stdev 1)
    - `(cv (range 2 6))` → `~39.5` (more spread relative to the mean)
  """
  body (flush (r (maths.mul (maths.div (stdev xs) (collections.mean xs)) 100)))
  test (is (cv (range 1 3)) 50)
}
