; funk/std — text (string helpers, pure Python)

package "funk/std/text" {
  version 0.0.1
}

fn split {
  name "Split"
  doc """
    # Split
    ### Split a string into a list of substrings around each occurrence of `sep`.
  """
  in  (a Str (doc "The string to split"))
      (sep Str (doc "The separator to split on"))
  out (r List (doc "The list of substrings between separators"))
  examples """
    - `(split "a,b,c" ",")` → `["a","b","c"]`
    - `(split "hello" "l")` → `["he","","o"]`
  """
  engine python
  src """
    return a.split(sep)
  """
}

fn join {
  name "Join"
  doc """
    # Join
    ### Join a list of values into a single string, placing `sep` between each element.
  """
  in  (xs List (doc "The list of values to join"))
      (sep Str (doc "The separator inserted between elements"))
  out (r Str (doc "The concatenated string"))
  examples """
    - `(join ["a","b","c"] "-")` → `"a-b-c"`
    - `(join ["x","y"] ", ")` → `"x, y"`
  """
  engine python
  src """
    return sep.join(str(x) for x in xs)
  """
}

fn replace {
  name "Replace"
  doc """
    # Replace
    ### Replace every occurrence of `old` with `new` in the string `a`.
  """
  in  (a Str (doc "The string to search in"))
      (old Str (doc "The substring to replace"))
      (new Str (doc "The replacement substring"))
  out (r Str (doc "The string with all replacements applied"))
  examples """
    - `(replace "banana" "a" "o")` → `"bonono"`
    - `(replace "a-b-c" "-" "+")` → `"a+b+c"`
  """
  engine python
  src """
    return a.replace(old, new)
  """
}

fn contains? {
  name "Contains"
  doc """
    # Contains
    ### Return `true` if the string `a` contains the substring `sub`.
  """
  in  (a Str (doc "The string to search in"))
      (sub Str (doc "The substring to look for"))
  out (r Bool (doc "`true` if `sub` occurs in `a`, else `false`"))
  examples """
    - `(contains? "hello" "ell")` → `true`
    - `(contains? "hello" "xyz")` → `false`
  """
  engine python
  src """
    return sub in a
  """
}

fn startsWith? {
  name "Starts With"
  doc """
    # Starts With
    ### Return `true` if the string `a` begins with `prefix`.
  """
  in  (a Str (doc "The string to test"))
      (prefix Str (doc "The prefix to check for"))
  out (r Bool (doc "`true` if `a` starts with `prefix`, else `false`"))
  examples """
    - `(startsWith? "hello" "he")` → `true`
    - `(startsWith? "hello" "lo")` → `false`
  """
  engine python
  src """
    return a.startswith(prefix)
  """
}

fn endsWith? {
  name "Ends With"
  doc """
    # Ends With
    ### Return `true` if the string `a` ends with `suffix`.
  """
  in  (a Str (doc "The string to test"))
      (suffix Str (doc "The suffix to check for"))
  out (r Bool (doc "`true` if `a` ends with `suffix`, else `false`"))
  examples """
    - `(endsWith? "hello" "lo")` → `true`
    - `(endsWith? "hello" "he")` → `false`
  """
  engine python
  src """
    return a.endswith(suffix)
  """
}

fn reverse {
  name "Reverse"
  doc """
    # Reverse
    ### Reverse the order of the characters in a string.
  """
  in  (a Str (doc "The string to reverse"))
  out (r Str (doc "The string with its characters in reverse order"))
  examples """
    - `(reverse "hello")` → `"olleh"`
    - `(reverse "abc")` → `"cba"`
  """
  engine python
  src """
    return a[::-1]
  """
}

fn words {
  name "Words"
  doc """
    # Words
    ### Split a string on runs of whitespace into a list of words, discarding empty entries.
  """
  in  (a Str (doc "The string to tokenize"))
  out (r List (doc "The list of whitespace-separated words"))
  examples """
    - `(words "foo bar baz")` → `["foo","bar","baz"]`
    - `(words "  a   b ")` → `["a","b"]`
  """
  engine python
  src """
    return a.split()
  """
}

fn capitalize {
  name "Capitalize"
  doc """
    # Capitalize
    ### Capitalize the first character of a string and lowercase the rest.
  """
  in  (a Str (doc "The string to capitalize"))
  out (r Str (doc "The string with an uppercase first character and lowercase remainder"))
  examples """
    - `(capitalize "hello world")` → `"Hello world"`
    - `(capitalize "ABC")` → `"Abc"`
  """
  engine python
  src """
    return a.capitalize()
  """
}

fn repeat {
  name "Repeat"
  doc """
    # Repeat
    ### Repeat a string `n` times, concatenated end to end.
  """
  in  (a Str (doc "The string to repeat"))
      (n Num (doc "The number of repetitions"))
  out (r Str (doc "The string `a` repeated `n` times"))
  examples """
    - `(repeat "ab" 3)` → `"ababab"`
    - `(repeat "x" 0)` → `""`
  """
  engine python
  src """
    return a * int(n)
  """
}
