; funk/std — unary number functions (used as map/filter arguments)

package "funk/std/maths" {
  version 0.0.1
}

fn double {
  name "Double"
  doc """
    # Double
    ### Multiply a number by two.
  """
  in  (a Num (doc "The number to double"))
  out (r Num (doc "`a * 2`"))
  examples """
    - `(double 21)` → `42`
    - `(double -3)` → `-6`
  """
  engine builtin
  src """
    num.double
  """
}

fn square {
  name "Square"
  doc """
    # Square
    ### Multiply a number by itself.
  """
  in  (a Num (doc "The number to square"))
  out (r Num (doc "`a * a`, always non-negative"))
  examples """
    - `(square 5)` → `25`
    - `(square -4)` → `16`
  """
  engine builtin
  src """
    num.square
  """
}

fn inc {
  name "Increment"
  doc """
    # Increment
    ### Add one to a number.
  """
  in  (a Num (doc "The number to increment"))
  out (r Num (doc "`a + 1`"))
  examples """
    - `(inc 41)` → `42`
    - `(inc -1)` → `0`
  """
  engine builtin
  src """
    num.inc
  """
}

fn even? {
  name "Is Even"
  doc """
    # Is Even
    ### Test whether a number is even.
  """
  in  (a Num (doc "The number to test"))
  out (r Bool (doc "`true` if `a` is divisible by 2, else `false`"))
  examples """
    - `(even? 4)` → `true`
    - `(even? 7)` → `false`
  """
  engine builtin
  src """
    num.even
  """
}
