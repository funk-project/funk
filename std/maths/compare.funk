; funk/std — comparisons (Num → Bool)

package "funk/std/maths" {
  version 0.0.1
}

fn gt {
  name "Greater Than"
  doc """
    # Greater Than
    ### Test whether `a` is strictly greater than `b`.
  """
  in  (a Num (doc "The left operand"))
      (b Num (doc "The right operand"))
  out (r Bool (doc "`true` if `a > b`, else `false`"))
  examples """
    - `(gt 5 3)` → `true`
    - `(gt 3 3)` → `false`
  """
  engine builtin
  src "num.gt"
}

fn lt {
  name "Less Than"
  doc """
    # Less Than
    ### Test whether `a` is strictly less than `b`.
  """
  in  (a Num (doc "The left operand"))
      (b Num (doc "The right operand"))
  out (r Bool (doc "`true` if `a < b`, else `false`"))
  examples """
    - `(lt 3 5)` → `true`
    - `(lt 5 3)` → `false`
  """
  engine builtin
  src "num.lt"
}

fn gte {
  name "Greater Than Or Equal"
  doc """
    # Greater Than Or Equal
    ### Test whether `a` is greater than or equal to `b`.
  """
  in  (a Num (doc "The left operand"))
      (b Num (doc "The right operand"))
  out (r Bool (doc "`true` if `a >= b`, else `false`"))
  examples """
    - `(gte 3 3)` → `true`
    - `(gte 2 3)` → `false`
  """
  engine builtin
  src "num.gte"
}

fn lte {
  name "Less Than Or Equal"
  doc """
    # Less Than Or Equal
    ### Test whether `a` is less than or equal to `b`.
  """
  in  (a Num (doc "The left operand"))
      (b Num (doc "The right operand"))
  out (r Bool (doc "`true` if `a <= b`, else `false`"))
  examples """
    - `(lte 3 3)` → `true`
    - `(lte 4 3)` → `false`
  """
  engine builtin
  src "num.lte"
}

fn eq {
  name "Equals"
  doc """
    # Equals
    ### Test whether `a` equals `b`.
  """
  in  (a Num (doc "The left operand"))
      (b Num (doc "The right operand"))
  out (r Bool (doc "`true` if `a == b`, else `false`"))
  examples """
    - `(eq 4 4)` → `true`
    - `(eq 4 5)` → `false`
  """
  engine builtin
  src "num.eq"
}

fn neq {
  name "Not Equal"
  doc """
    # Not Equal
    ### Test whether `a` does not equal `b`.
  """
  in  (a Num (doc "The left operand"))
      (b Num (doc "The right operand"))
  out (r Bool (doc "`true` if `a != b`, else `false`"))
  examples """
    - `(neq 1 2)` → `true`
    - `(neq 2 2)` → `false`
  """
  engine builtin
  src "num.neq"
}
