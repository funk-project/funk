; funk/std — encoding (json, base64, url)

package "funk/std/encoding" {
  version 0.0.1
}

fn jsonParse {
  name "Parse JSON"
  doc """
    # Parse JSON
    ### Parse a JSON string into a `Json` value (object, array, number, string, boolean, or null).
  """
  in  (a Str (doc "A JSON-encoded string"))
  out (r Json (doc "The decoded value"))
  examples """
    - `(jsonParse "[1, 2]")` → `[1, 2]`
    - `(jsonParse "{\"a\": 1}")` → `{"a": 1}`
  """
  engine python
  src """
    import json
    return json.loads(a)
  """
}

fn jsonStringify {
  name "Stringify JSON"
  doc """
    # Stringify JSON
    ### Serialize a `Json` value to a compact JSON string.
  """
  in  (a Json (doc "The value to serialize"))
  out (r Str (doc "The JSON-encoded string"))
  examples """
    - `(jsonStringify [1, 2])` → `"[1,2]"`
    - `(jsonStringify {"a": 1})` → `"{\"a\":1}"`
  """
  engine python
  src """
    import json
    return json.dumps(a)
  """
}

fn base64Encode {
  name "Base64 Encode"
  doc """
    # Base64 Encode
    ### Base64-encode a UTF-8 string.
  """
  in  (a Str (doc "The UTF-8 string to encode"))
  out (r Str (doc "The base64-encoded (ASCII) representation of `a`"))
  examples """
    - `(base64Encode "hi")` → `"aGk="`
    - `(base64Encode "funk")` → `"ZnVuaw=="`
  """
  engine python
  src """
    import base64
    return base64.b64encode(a.encode('utf-8')).decode('ascii')
  """
}

fn base64Decode {
  name "Base64 Decode"
  doc """
    # Base64 Decode
    ### Decode a base64 string back into a UTF-8 string.
  """
  in  (a Str (doc "The base64-encoded string to decode"))
  out (r Str (doc "The decoded UTF-8 string"))
  examples """
    - `(base64Decode "aGk=")` → `"hi"`
    - `(base64Decode "ZnVuaw==")` → `"funk"`
  """
  engine python
  src """
    import base64
    return base64.b64decode(a.encode('ascii')).decode('utf-8')
  """
}

fn urlEncode {
  name "URL Encode"
  doc """
    # URL Encode
    ### Percent-encode a string so it is safe to use in a URL (all reserved characters escaped).
  """
  in  (a Str (doc "The string to percent-encode"))
  out (r Str (doc "The percent-encoded string"))
  examples """
    - `(urlEncode "a b&c")` → `"a%20b%26c"`
    - `(urlEncode "x/y")` → `"x%2Fy"`
  """
  engine python
  src """
    import urllib.parse
    return urllib.parse.quote(a, safe='')
  """
}

fn urlDecode {
  name "URL Decode"
  doc """
    # URL Decode
    ### Decode a percent-encoded URL string back to its original text.
  """
  in  (a Str (doc "The percent-encoded string to decode"))
  out (r Str (doc "The decoded string"))
  examples """
    - `(urlDecode "a%20b")` → `"a b"`
    - `(urlDecode "x%2Fy")` → `"x/y"`
  """
  engine python
  src """
    import urllib.parse
    return urllib.parse.unquote(a)
  """
}
