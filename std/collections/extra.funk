; funk/std — collections (extra List operations)
; NOTE: adds to the existing "funk/std/collections" package (see list.funk).

package "funk/std/collections" {
  version 0.0.1
}

fn reverse {
  name "Reverse"
  doc """
    # Reverse
    ### Reverse the order of a list.
  """
  in  (a List (doc "The list to reverse"))
  out (r List (doc "A new list with `a`'s items in reverse order"))
  examples """
    - `(reverse [1, 2, 3])` → `[3, 2, 1]`
    - `(reverse [])` → `[]`
  """
  engine python
  src """
    return list(reversed(a))
  """
}

fn sort {
  name "Sort"
  doc """
    # Sort
    ### Sort a list into ascending order.
  """
  in  (a List (doc "The list to sort"))
  out (r List (doc "A new list with `a`'s items in ascending order"))
  examples """
    - `(sort [3, 1, 2])` → `[1, 2, 3]`
    - `(sort [5])` → `[5]`
  """
  engine python
  src """
    return sorted(a)
  """
}

fn unique {
  name "Unique"
  doc """
    # Unique
    ### Distinct items of a list, preserving first-seen order.
  """
  in  (a List (doc "The list to deduplicate"))
  out (r List (doc "`a` with later duplicate items removed"))
  examples """
    - `(unique [1, 1, 2, 3, 3])` → `[1, 2, 3]`
    - `(unique [3, 1, 3, 2])` → `[3, 1, 2]`
  """
  engine python
  src """
    seen = []
    for x in a:
        if x not in seen:
            seen.append(x)
    return seen
  """
}

fn take {
  name "Take"
  doc """
    # Take
    ### The first `n` items of a list.
  """
  in  (a List (doc "The source list"))
      (n Num  (doc "How many leading items to keep"))
  out (r List (doc "At most the first `n` items of `a`"))
  examples """
    - `(take [1, 2, 3, 4] 2)` → `[1, 2]`
    - `(take [1, 2] 5)` → `[1, 2]`
  """
  engine python
  src """
    return a[:int(n)]
  """
}

fn drop {
  name "Drop"
  doc """
    # Drop
    ### A list without its first `n` items.
  """
  in  (a List (doc "The source list"))
      (n Num  (doc "How many leading items to discard"))
  out (r List (doc "`a` with its first `n` items removed"))
  examples """
    - `(drop [1, 2, 3, 4] 2)` → `[3, 4]`
    - `(drop [1, 2] 5)` → `[]`
  """
  engine python
  src """
    return a[int(n):]
  """
}

fn flatten {
  name "Flatten"
  doc """
    # Flatten
    ### Flatten a list of lists by one level, leaving non-list items in place.
  """
  in  (a List (doc "The list to flatten one level"))
  out (r List (doc "`a` with any nested lists spliced in, one level deep"))
  examples """
    - `(flatten [[1, 2], [3], 4])` → `[1, 2, 3, 4]`
    - `(flatten [[1], [2, 3]])` → `[1, 2, 3]`
  """
  engine python
  src """
    out = []
    for x in a:
        if isinstance(x, list):
            out.extend(x)
        else:
            out.append(x)
    return out
  """
}

fn zip2 {
  name "Zip Two"
  doc """
    # Zip Two
    ### Pairwise zip two lists into a list of `[x, y]` pairs, stopping at the shorter list.
  """
  in  (a List (doc "The first list, giving each pair's left item"))
      (b List (doc "The second list, giving each pair's right item"))
  out (r List (doc "A list of `[x, y]` pairs drawn positionally from `a` and `b`"))
  examples """
    - `(zip2 [1, 2, 3] [4, 5, 6])` → `[[1, 4], [2, 5], [3, 6]]`
    - `(zip2 [1, 2, 3] [4])` → `[[1, 4]]`
  """
  engine python
  src """
    return [[x, y] for x, y in zip(a, b)]
  """
}

fn contains? {
  name "Contains"
  doc """
    # Contains
    ### True if the list contains the given item.
  """
  in  (a List    (doc "The list to search"))
      (item Any  (doc "The item to look for"))
  out (r Bool (doc "`true` if `item` is an element of `a`, else `false`"))
  examples """
    - `(contains? [1, 2, 3] 2)` → `true`
    - `(contains? [1, 2, 3] 9)` → `false`
  """
  engine python
  src """
    return item in a
  """
}
