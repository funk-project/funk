; funk/std — aggregates DEFINED IN FUNK, over the `fold` primitive.
; sum / count / mean / product are no longer Go builtins — they are readable funk
; compositions. The irreducible arithmetic (add/mul/div) stays a primitive; the
; composition is funk. This is funk written in funk.

package "funk/std/collections" {
  version 0.0.1
  use "funk/std/maths" as maths
}

fn incAcc {
  name "Increment Accumulator"
  doc """
    # Increment Accumulator
    ### Fold step that adds one to the accumulator, ignoring the item — powers `count`.
  """
  in  (a Num (doc "The running accumulator"))
      (b Any (doc "The current item (ignored)"))
  out (r Num (doc "The accumulator plus one, `a + 1`"))
  examples """
    - `(incAcc 5 99)` → `6`
    - `(incAcc 0 "x")` → `1`
  """
  body (flush (r (maths.inc a)))
}

fn sum {
  name "Sum"
  doc """
    # Sum
    ### Sum of a list or stream of numbers (`fold` with `add` from `0`).
  """
  in  (xs List (doc "The numbers to add up"))
  out (r Num (doc "The total of every item in `xs`"))
  examples """
    - `(sum (range 1 5))` → `15`
    - `(sum [1, 2, 3, 4])` → `10`
  """
  body (flush (r (fold xs maths.add 0)))
  test (is (sum (range 1 5)) 15)
}

fn count {
  name "Count"
  doc """
    # Count
    ### Number of items in a list or stream (`fold` incrementing once per item).
  """
  in  (xs List (doc "The list or stream to measure"))
  out (r Num (doc "How many items `xs` contains"))
  examples """
    - `(count (range 1 5))` → `5`
    - `(count [7, 8, 9])` → `3`
  """
  body (flush (r (fold xs incAcc 0)))
  test (is (count (range 1 5)) 5)
}

fn product {
  name "Product"
  doc """
    # Product
    ### Product of a list or stream of numbers (`fold` with `mul` from `1`).
  """
  in  (xs List (doc "The numbers to multiply together"))
  out (r Num (doc "The product of every item in `xs`"))
  examples """
    - `(product (range 1 4))` → `24`
    - `(product [2, 5])` → `10`
  """
  body (flush (r (fold xs maths.mul 1)))
  test (is (product (range 1 4)) 24)
}

fn mean {
  name "Mean"
  doc """
    # Mean
    ### Arithmetic mean of a list — its `sum` divided by its `count`, written in funk.
  """
  in  (xs List (doc "The numbers to average"))
  out (r Num (doc "The mean of `xs`, `sum / count`"))
  examples """
    - `(mean (range 1 5))` → `3`
    - `(mean [2, 4, 6])` → `4`
  """
  body
    (let (l (collect xs))
      (flush (r (maths.div (sum l) (count l)))))
  test (is (mean (range 1 5)) 3)
}
