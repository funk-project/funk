; funk/std — mathx (extended math, Python `math`)

package "funk/std/mathx" {
  version 0.0.1
}

fn floor {
  name "Floor"
  doc """
    # Floor
    ### Round `a` down to the largest integer that is `≤ a`.
  """
  in  (a Num (doc "The number to round down"))
  out (r Num (doc "The greatest integer `≤ a`"))
  examples """
    - `(floor 3.7)` → `3`
    - `(floor -2.5)` → `-3`
  """
  engine python
  src "import math\nreturn math.floor(a)"
}

fn ceil {
  name "Ceiling"
  doc """
    # Ceiling
    ### Round `a` up to the smallest integer that is `≥ a`.
  """
  in  (a Num (doc "The number to round up"))
  out (r Num (doc "The smallest integer `≥ a`"))
  examples """
    - `(ceil 3.2)` → `4`
    - `(ceil -2.5)` → `-2`
  """
  engine python
  src "import math\nreturn math.ceil(a)"
}

fn round {
  name "Round"
  doc """
    # Round
    ### Round `a` to `n` decimal places.
  """
  in  (a Num (doc "The number to round"))
      (n Num (doc "The number of decimal places to keep"))
  out (r Num (doc "`a` rounded to `n` decimal places"))
  examples """
    - `(round 3.14159 2)` → `3.14`
    - `(round 2.71828 0)` → `3`
  """
  engine python
  src "return round(a, int(n))"
}

fn log {
  name "Natural Log"
  doc """
    # Natural Log
    ### Natural logarithm (base `e`) of `a`.
  """
  in  (a Num (doc "The argument (must be `> 0`)"))
  out (r Num (doc "The natural logarithm `ln(a)`"))
  examples """
    - `(log 1)` → `0`
    - `(log 2.718281828)` → `0.999…`
  """
  engine python
  src "import math\nreturn math.log(a)"
}

fn log10 {
  name "Log Base 10"
  doc """
    # Log Base 10
    ### Base-10 logarithm of `a`.
  """
  in  (a Num (doc "The argument (must be `> 0`)"))
  out (r Num (doc "The base-10 logarithm `log₁₀(a)`"))
  examples """
    - `(log10 1000)` → `3`
    - `(log10 1)` → `0`
  """
  engine python
  src "import math\nreturn math.log10(a)"
}

fn exp {
  name "Exponential"
  doc """
    # Exponential
    ### `e` raised to the power `a`.
  """
  in  (a Num (doc "The exponent"))
  out (r Num (doc "`e` raised to the `a`"))
  examples """
    - `(exp 0)` → `1`
    - `(exp 1)` → `2.718…`
  """
  engine python
  src "import math\nreturn math.exp(a)"
}

fn sin {
  name "Sine"
  doc """
    # Sine
    ### Sine of `a`, where `a` is in radians.
  """
  in  (a Num (doc "The angle in radians"))
  out (r Num (doc "The sine of `a`, in the range `[-1, 1]`"))
  examples """
    - `(sin 0)` → `0`
    - `(sin 1)` → `0.841…`
  """
  engine python
  src "import math\nreturn math.sin(a)"
}

fn cos {
  name "Cosine"
  doc """
    # Cosine
    ### Cosine of `a`, where `a` is in radians.
  """
  in  (a Num (doc "The angle in radians"))
  out (r Num (doc "The cosine of `a`, in the range `[-1, 1]`"))
  examples """
    - `(cos 0)` → `1`
    - `(cos 1)` → `0.540…`
  """
  engine python
  src "import math\nreturn math.cos(a)"
}

fn tan {
  name "Tangent"
  doc """
    # Tangent
    ### Tangent of `a`, where `a` is in radians.
  """
  in  (a Num (doc "The angle in radians"))
  out (r Num (doc "The tangent of `a`"))
  examples """
    - `(tan 0)` → `0`
    - `(tan 1)` → `1.557…`
  """
  engine python
  src "import math\nreturn math.tan(a)"
}

fn factorial {
  name "Factorial"
  doc """
    # Factorial
    ### Factorial of a non-negative integer `a` (the product `1 × 2 × … × a`).
  """
  in  (a Num (doc "A non-negative integer"))
  out (r Num (doc "`a!`, the factorial of `a`"))
  examples """
    - `(factorial 5)` → `120`
    - `(factorial 0)` → `1`
  """
  engine python
  src "import math\nreturn math.factorial(int(a))"
}

fn gcd {
  name "Greatest Common Divisor"
  doc """
    # Greatest Common Divisor
    ### Greatest common divisor of integers `a` and `b`.
  """
  in  (a Num (doc "The first integer"))
      (b Num (doc "The second integer"))
  out (r Num (doc "The largest integer that divides both `a` and `b`"))
  examples """
    - `(gcd 12 8)` → `4`
    - `(gcd 17 5)` → `1`
  """
  engine python
  src "import math\nreturn math.gcd(int(a), int(b))"
}

fn clamp {
  name "Clamp"
  doc """
    # Clamp
    ### Constrain `x` to the inclusive range `[lo, hi]`.
  """
  in  (x Num (doc "The value to clamp"))
      (lo Num (doc "The lower bound"))
      (hi Num (doc "The upper bound"))
  out (r Num (doc "`x` limited to the range `[lo, hi]`"))
  examples """
    - `(clamp 5 0 10)` → `5`
    - `(clamp 15 0 10)` → `10`
  """
  engine python
  src "return max(lo, min(hi, x))"
}
