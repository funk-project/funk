; funk/std — skills: the self-programming layer.
;
; Each skill is a function on the `claude` engine (an AI role). Composed, they
; let funk write funk: architect -> programmer -> reviewer -> tester -> reflect.
; This is the thesis in action — the plan (a funk workflow) whose nodes are the
; agents that build and improve the plan. `reflect` self-analyzes and, if needed,
; rewrites the source (docs/01 — the self-improving kernel).

package "funk/std/skills" {
  version 0.0.1
}

fn architect {
  name "Architect"
  doc """
    # Architect
    ### Turn a task description into a concise, single-function `funk` design (name, ports, engine, approach).
  """
  in  (task Str (doc "A natural-language description of the task to design a function for"))
  out (design Str (doc "A terse design for one function: name, input ports, output port, engine, and approach"))
  examples """
    - `(architect "reverse the words in a string")` → `reverseWords / in (s Str) / out (r Str) / python / split, reverse, join`
    - `(architect "add two numbers")` → `add / in (a Num) (b Num) / out (r Num) / python / return a + b`
  """
  engine claude
  src """
    You are a software architect for funk, a workflow language. The task may list
    reusable funk functions already in the library. Produce a TERSE design for ONE
    function: a snake or camelCase name, the inputs as (name Type), the single
    output (r Type), and a one-line approach.
    If the listed reusable functions can cover the logic, design a COMPOSITE that
    calls them (name the addresses to compose). Otherwise design an atomic python fn.
    Types are Num Str Bool List Json. Output only the design, no prose.
  """
}

fn programmer {
  name "Programmer"
  doc """
    # Programmer
    ### Turn a function design into a single valid `.funk` `fn` block.
  """
  in  (design Str (doc "A function design, e.g. the output of `architect`"))
  out (code Str (doc "One complete `fn` block implementing the design"))
  examples """
    - `(programmer "add / in (a Num) (b Num) / out (r Num) / python")` → `fn add { doc "..." in (a Num) (b Num) out (r Num) engine python src "return a + b" }`
    - `(programmer "<design for upper>")` → `fn upper { ... src "return s.upper()" }`
  """
  engine claude
  src """
    You write functions in funk. Output ONLY one fn block — no markdown, no fences, no prose.

    If the design composes existing functions, write a COMPOSITE fn that calls them
    BY FULL ADDRESS and emits with flush:

    fn NAME {
      doc "one line"
      in (x Num)
      out (r Num)
      body (flush (r (funk/std/maths/add x 1)))
    }

    Otherwise write an ATOMIC python fn:

    fn NAME {
      doc "one line"
      in (a Num)
      out (r Num)
      engine python
      src "return a + 1"
    }

    Types are Num Str Bool List Json. In a python src each input port is already a
    local variable and you must return the result; escape newlines as \n and quotes
    as \". Prefer composing library functions over reinventing. Keep it minimal.
  """
}

fn reviewer {
  name "Reviewer"
  doc """
    # Reviewer
    ### Review a `.funk` function for correctness and clarity, ending with a `PASS`/`NEEDS-WORK` verdict.
  """
  in  (code Str (doc "The `fn` block to review"))
  out (review Str (doc "A short bulleted review ending with a `PASS` or `NEEDS-WORK` verdict line"))
  examples """
    - `(reviewer "fn add { ... src \"return a + b\" }")` → `- Python is correct ... Verdict: PASS`
    - `(reviewer "fn div { ... src \"return a / b\" }")` → `- No zero-divisor guard ... Verdict: NEEDS-WORK`
  """
  engine claude
  src "You are a code reviewer for `funk`. Review the given `fn` block: is the Python correct, are the port types right, is the doc clear, are edge cases handled? Reply with a short bulleted review ending with a verdict line: PASS or NEEDS-WORK."
}

fn tester {
  name "Tester"
  doc """
    # Tester
    ### Propose concrete test cases for a `.funk` function and give a `LIKELY-CORRECT`/`SUSPECT` verdict.
  """
  in  (code Str (doc "The `fn` block to test"))
  out (verdict Str (doc "2-3 input->expected-output test cases followed by a `LIKELY-CORRECT` or `SUSPECT` verdict"))
  examples """
    - `(tester "fn add { ... src \"return a + b\" }")` → `add 2 3 -> 5 ... Verdict: LIKELY-CORRECT`
    - `(tester "fn add { ... src \"return a - b\" }")` → `add 2 3 -> 5 but got -1 ... Verdict: SUSPECT`
  """
  engine claude
  src "You are a tester for `funk`. For the given `fn` block, list 2-3 concrete input->expected-output test cases, then a verdict: LIKELY-CORRECT or SUSPECT, with one line of reasoning."
}

fn reflect {
  name "Reflect"
  doc """
    # Reflect
    ### Self-analyze a function against a report and rewrite its source if the report reveals a problem.
  """
  in  (code Str (doc "The `fn` block to analyze"))
      (report Str (doc "A report about the function — an error, review, or run result"))
  out (code Str (doc "A corrected `fn` block if the report shows a problem, otherwise the same block unchanged"))
  examples """
    - `(reflect "fn div { ... }" "error: division by zero")` → `fn div { ... src "if b == 0: raise ... return a / b" }`
    - `(reflect "fn add { ... }" "Verdict: PASS")` → `fn add { ... }` (unchanged)
  """
  engine claude
  src "You improve `funk` source. You are given a `fn` block and a report (an error, review, or run result). If the report shows a problem, output a CORRECTED `fn` block; if it is already fine, output the SAME block unchanged. Output ONLY the fn block — no markdown, no fences, no prose. Keep engine python; escape newlines in src as \\n and quotes as \\\"."
}

fn covers {
  name "Covers"
  doc """
    # Covers
    ### The reuse gate — decide whether an existing function already fully satisfies a task, so `make` reuses instead of generating a duplicate.
  """
  in  (task Str (doc "The task description"))
      (candidate Str (doc "An existing function as `address : signature — doc`"))
  out (verdict Str (doc "`YES` if the candidate already satisfies the task, else `NO`"))
  examples """
    - `(covers "the average of a list" ".../mean : (List Num) -> Num — arithmetic mean")` → `YES`
    - `(covers "the average of the squares" ".../mean : (List Num) -> Num — arithmetic mean")` → `NO`
  """
  engine claude
  src "You are the reuse gate for `funk`. Given a TASK and a CANDIDATE function (address, signature, doc), answer YES only if calling that candidate as-is fully satisfies the task — same computation, same result. If it is merely related, partial, or would need extra work, answer NO. Output ONLY YES or NO."
}

; The core generation pipeline, expressed IN funk: task -> design -> code.
fn generate {
  name "Generate"
  doc """
    # Generate
    ### Generate a `funk` function from a task by chaining `architect` then `programmer`.
  """
  in  (task Str (doc "A natural-language description of the function to generate"))
  out (code Str (doc "The generated `fn` block"))
  examples """
    - `(generate "reverse the words in a string")` → `fn reverseWords { ... src "return ' '.join(reversed(s.split()))" }`
    - `(generate "square a number")` → `fn square { ... src "return n * n" }`
  """
  body
    (flush (code (programmer (architect task))))
}
