; funk/std — logic, DEFINED IN FUNK over `if` (short-circuiting). Not Go builtins.

package "funk/std/logic" {
  version 0.0.1
}

fn and {
  name "Logical And"
  doc """
    # Logical And
    ### Logical **and** of two booleans; short-circuits, returning `b` only when `a` is `true`.
  """
  in  (a Bool (doc "The left operand (evaluated first)"))
      (b Bool (doc "The right operand, returned when `a` is `true`"))
  out (r Bool (doc "`true` if both `a` and `b` are `true`, else `false`"))
  examples """
    - `(and true false)` → `false`
    - `(and true true)` → `true`
  """
  body (if a (flush (r b)) (flush (r false)))
  test (is (and true false) false)
}

fn or {
  name "Logical Or"
  doc """
    # Logical Or
    ### Logical **or** of two booleans; short-circuits, returning `b` only when `a` is `false`.
  """
  in  (a Bool (doc "The left operand (evaluated first)"))
      (b Bool (doc "The right operand, returned when `a` is `false`"))
  out (r Bool (doc "`true` if either `a` or `b` is `true`, else `false`"))
  examples """
    - `(or false true)` → `true`
    - `(or false false)` → `false`
  """
  body (if a (flush (r true)) (flush (r b)))
  test (is (or false true) true)
}

fn not {
  name "Logical Not"
  doc """
    # Logical Not
    ### Logical negation of a boolean.
  """
  in  (a Bool (doc "The boolean to negate"))
  out (r Bool (doc "`true` if `a` is `false`, else `false`"))
  examples """
    - `(not false)` → `true`
    - `(not true)` → `false`
  """
  body (if a (flush (r false)) (flush (r true)))
  test (is (not false) true)
}

fn nand {
  name "Logical Nand"
  doc """
    # Logical Nand
    ### Negated `and` — `false` only when both `a` and `b` are `true`.
  """
  in  (a Bool (doc "The left operand"))
      (b Bool (doc "The right operand"))
  out (r Bool (doc "`false` if both are `true`, else `true`"))
  examples """
    - `(nand true true)` → `false`
    - `(nand true false)` → `true`
  """
  body (flush (r (not (and a b))))
  test (is (nand true true) false)
}

fn nor {
  name "Logical Nor"
  doc """
    # Logical Nor
    ### Negated `or` — `true` only when both `a` and `b` are `false`.
  """
  in  (a Bool (doc "The left operand"))
      (b Bool (doc "The right operand"))
  out (r Bool (doc "`true` if both are `false`, else `false`"))
  examples """
    - `(nor false false)` → `true`
    - `(nor true false)` → `false`
  """
  body (flush (r (not (or a b))))
  test (is (nor false false) true)
}

fn xor {
  name "Logical Xor"
  doc """
    # Logical Xor
    ### Exclusive or — `true` when exactly one of `a`, `b` is `true`.
  """
  in  (a Bool (doc "The left operand"))
      (b Bool (doc "The right operand"))
  out (r Bool (doc "`true` when `a` and `b` differ, else `false`"))
  examples """
    - `(xor true false)` → `true`
    - `(xor true true)` → `false`
  """
  body (if a (flush (r (not b))) (flush (r b)))
  test (is (xor true true) false)
}
