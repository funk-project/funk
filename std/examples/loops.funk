; funk/std — loop examples (the `while` core form: stateful iteration).

package "funk/std/examples" {
  version 0.0.1
  use "funk/std/maths" as maths
}

fn powTwoLE {
  doc """
    # Pow Two LE
    ### The largest power of two less than or equal to `n`, computed via a `while` loop that doubles until the next double would exceed `n`.
  """
  in  (n Num (doc "The upper bound (inclusive)"))
  out (r Num (doc "The greatest power of two `≤ n`"))
  examples """
    - `(powTwoLE 100)` → `64`
    - `(powTwoLE 1000)` → `512`
  """
  body
    (while (s 1)
      (maths.lte (maths.mul s 2) n)
      (maths.mul s 2))
  test (is (powTwoLE 100) 64)
  test (is (powTwoLE 1000) 512)
}

fn countUp {
  doc """
    # Count Up
    ### Count up from `0` to `n`, returning `n` — a minimal `while` loop that increments while `s < n`.
  """
  in  (n Num (doc "The target value to count up to"))
  out (r Num (doc "`n` (the final counter value)"))
  examples """
    - `(countUp 5)` → `5`
    - `(countUp 0)` → `0`
  """
  body
    (while (s 0)
      (maths.lt s n)
      (maths.inc s))
}
