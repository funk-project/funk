; funk/std — loop examples (the `while` core form: stateful iteration).

package "funk/std/examples" {
  version 0.0.1
  use "funk/std/maths" as maths
}

fn powTwoLE {
  doc "largest power of two <= n, via a while loop"
  in  (n Num)
  out (r Num)
  body
    (while (s 1)
      (maths.lte (maths.mul s 2) n)
      (maths.mul s 2))
  test (is (powTwoLE 100) 64)
  test (is (powTwoLE 1000) 512)
}

fn countUp {
  doc "count up to n (returns n) — a minimal while"
  in  (n Num)
  out (r Num)
  body
    (while (s 0)
      (maths.lt s n)
      (maths.inc s))
}
