; funk/std — runtime resource injection (docs/05).
; needs are resolved from --bind (or env FUNK_<KIND>_<ALIAS>) and injected:
; python bodies read `needs['kind']['alias']`; funk bodies read needs.kind.alias.

package "funk/std/examples" {
  version 0.0.1
  use "funk/std/strings" as strings
}

fn secretPeek {
  doc """
    # Secret Peek
    ### Show a `config` value alongside a masked `secret` — both injected at runtime into the python body, which keeps only the first three characters of the secret.
  """
  in  ()
  out (r Str (doc "`<config.repo> @ <first 3 chars of secret.token>***`"))
  examples """
    - with `config.repo=funk/std`, `secret.token=abcdef` → `funk/std @ abc***`
    - with `config.repo=me/app`, `secret.token=xyzzy` → `me/app @ xyz***`
  """
  engine python
  needs {
    config repo Str
    secret token
  }
  src """
    return needs['config']['repo'] + ' @ ' + needs['secret']['token'][:3] + '***'
  """
}

fn siteGreeting {
  doc """
    # Site Greeting
    ### Greet using an injected `config` value, read as `needs.config.site` in a funk body.
  """
  in  ()
  out (r Str (doc "The string `\"hello from \"` followed by the injected `config.site`"))
  examples """
    - with `config.site=example.com` → `hello from example.com`
    - with `config.site=funk.dev` → `hello from funk.dev`
  """
  needs {
    config site Str
  }
  body
    (flush (r (strings.concat "hello from " needs.config.site)))
}
