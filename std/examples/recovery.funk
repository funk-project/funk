; funk/std — recovery forms (docs/04 §6): on-error (fallback) and retry.
; Errors propagate-and-cancel by default; these forms opt into handling them.

package "funk/std/examples" {
  version 0.0.1
  use "funk/std/maths" as maths
}

fn safeDiv {
  doc """
    # Safe Div
    ### Divide `a` by `b`; on any error (e.g. divide-by-zero) fall back to `0` via `on-error`.
  """
  in  (a Num (doc "the dividend"))
      (b Num (doc "the divisor"))
  out (r Num (doc "the quotient `a / b`, or `0` if the division errors"))
  examples """
    - `(safeDiv 10 2)` → `5`
    - `(safeDiv 10 0)` → `0`
  """
  body (on-error (flush (r (maths.div a b))) (e) (flush (r 0)))
  test (is (safeDiv 10 2) 5)
  test (is (safeDiv 10 0) 0)
}

fn divOrDefault {
  doc """
    # Div Or Default
    ### Divide `a` by `b`; on any error return the supplied `fallback` instead.
  """
  in  (a Num (doc "the dividend"))
      (b Num (doc "the divisor"))
      (fallback Num (doc "the value to return if the division errors"))
  out (r Num (doc "the quotient `a / b`, or `fallback` if the division errors"))
  examples """
    - `(divOrDefault 9 3 -1)` → `3`
    - `(divOrDefault 9 0 -1)` → `-1`
  """
  body (on-error (flush (r (maths.div a b))) (e) (flush (r fallback)))
  test (is (divOrDefault 9 3 -1) 3)
  test (is (divOrDefault 9 0 -1) -1)
}
