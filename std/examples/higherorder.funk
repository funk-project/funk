; funk/std — first-class functions: a function passed as a value (an
; introspectable reference, not an opaque closure) and applied.

package "funk/std/examples" {
  version 0.0.1
  use "funk/std/maths" as maths
}

fn applyTwice {
  name "Apply Twice"
  doc """
    # Apply Twice
    ### Apply the function `f` to `x` twice — `f(f(x))` — demonstrating a function passed as a first-class value.
  """
  in  (f Fn (doc "The function to apply, taking and returning one `Num`"))
      (x Num (doc "The starting value"))
  out (r Num (doc "`f` applied to `x`, then to that result"))
  examples """
    - `(applyTwice double 5)` → `20`
    - `(applyTwice inc 10)` → `12`
  """
  body
    (flush (r (f (f x))))
}

fn quadruple {
  name "Quadruple"
  doc """
    # Quadruple
    ### Multiply `x` by four by passing `maths.double` to `applyTwice` (double, then double again).
  """
  in  (x Num (doc "The number to quadruple"))
  out (r Num (doc "`x * 4`"))
  examples """
    - `(quadruple 5)` → `20`
    - `(quadruple 3)` → `12`
  """
  body
    (flush (r (applyTwice maths.double x)))
  test (is (quadruple 5) 20)
}

fn compose2 {
  name "Compose Two"
  doc """
    # Compose Two
    ### Compose two functions: apply `g` to `x`, then `f` to that result — `f(g(x))`.
  """
  in  (f Fn (doc "The outer function, applied second"))
      (g Fn (doc "The inner function, applied first"))
      (x Num (doc "The starting value"))
  out (r Num (doc "`f` applied to `g(x)`"))
  examples """
    - `(compose2 square inc 4)` → `25`
    - `(compose2 double inc 3)` → `8`
  """
  body
    (flush (r (f (g x))))
}

fn incThenSquare {
  name "Increment Then Square"
  doc """
    # Increment Then Square
    ### Increment `x` then square it — `square(inc(x))` — built with `compose2`.
  """
  in  (x Num (doc "The number to increment then square"))
  out (r Num (doc "`(x + 1)²`"))
  examples """
    - `(incThenSquare 4)` → `25`
    - `(incThenSquare 2)` → `9`
  """
  body
    (flush (r (compose2 maths.square maths.inc x)))
  test (is (incThenSquare 4) 25)
}
