; funk/std — cookbook: small, practical, task-shaped functions used by
; docs/EXAMPLES.md. Each is self-contained and carries an inline test.

package "funk/std/examples" {
  version 0.0.1
  use "funk/std/maths" as maths
}

fn celsiusToF {
  name "Celsius To Fahrenheit"
  doc """
    # Celsius To Fahrenheit
    ### Convert a temperature in Celsius to Fahrenheit (`c * 1.8 + 32`).
  """
  in  (c Num (doc "The temperature in degrees Celsius"))
  out (r Num (doc "The same temperature in degrees Fahrenheit"))
  examples """
    - `(celsiusToF 100)` → `212`
    - `(celsiusToF 0)` → `32`
  """
  body (flush (r (maths.add (maths.mul c 1.8) 32)))
  test (is (celsiusToF 100) 212)
  test (is (celsiusToF 0) 32)
}

fn slugify {
  name "Slugify"
  doc """
    # Slugify
    ### Turn a title into a URL slug: lowercase it, collapse each run of non-alphanumeric characters into a single hyphen, and trim leading/trailing hyphens.
  """
  in  (s Str (doc "The title or phrase to slugify"))
  out (r Str (doc "The lowercase, hyphen-separated slug"))
  examples """
    - `(slugify "Hello, World!")` → `"hello-world"`
    - `(slugify "The Machine Is No Longer a Black Box!")` → `"the-machine-is-no-longer-a-black-box"`
  """
  engine python
  src "import re; return re.sub(r'[^a-z0-9]+', '-', s.lower()).strip('-')"
  test (is (slugify "The Machine Is No Longer a Black Box!") "the-machine-is-no-longer-a-black-box")
}

fn initials {
  name "Initials"
  doc """
    # Initials
    ### The uppercased first letter of each whitespace-separated word, joined together.
  """
  in  (s Str (doc "The phrase to take initials from"))
  out (r Str (doc "The concatenated, uppercased initials"))
  examples """
    - `(initials "funk over fear")` → `"FOF"`
    - `(initials "north by northwest")` → `"NBN"`
  """
  engine python
  src "return ''.join(w[0] for w in s.split()).upper()"
  test (is (initials "funk over fear") "FOF")
}

fn wordCount {
  name "Word Count"
  doc """
    # Word Count
    ### How many whitespace-separated words a sentence contains.
  """
  in  (s Str (doc "The sentence to count words in"))
  out (r Num (doc "The number of words in `s`"))
  examples """
    - `(wordCount "hello world")` → `2`
    - `(wordCount "a language for the plans AIs make")` → `7`
  """
  engine python
  src "return len(s.split())"
  test (is (wordCount "a language for the plans AIs make") 7)
}
