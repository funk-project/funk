; funk/std — examples: composite functions that exercise the graph executor.

package "funk/std/examples" {
  version 0.0.1
  use "funk/std/collections" as collections
  use "funk/std/maths" as maths
}

fn analyze {
  name "Analyze"
  doc """
    # Analyze
    ### Mean of the last 100 items of a stream, or `exit`s with `no data` when the stream is empty.
  """
  in  (xs Stream<Num> (doc "The stream of numbers to analyze"))
  out (r Num (doc "The mean over the last 100 items, or an early exit if `xs` is empty"))
  examples """
    - `(analyze [10, 20, 30])` → `20`
    - `(analyze [])` → `no data`
  """
  body
    (if (collections.isEmpty? xs)
      (exit "no data")
      (flush (r (collections.mean (window xs 100)))))
}

fn bump {
  name "Bump"
  doc """
    # Bump
    ### Add `100` to `x` when `x > 5`, otherwise pass `x` through unchanged — the condition gates the add.
  """
  in  (x Num (doc "The number to conditionally bump"))
  out (r Num (doc "`x + 100` if `x > 5`, else `x` unchanged"))
  examples """
    - `(bump 9)` → `109`
    - `(bump 3)` → `3`
  """
  body
    (if (maths.gt x 5)
      (flush (r (maths.add x 100)))
      (flush (r x)))
  test (is (bump 9) 109)
  test (is (bump 3) 3)
}
