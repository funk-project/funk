fn reverse_words {
  name "Reverse Words"
  doc """
    # Reverse Words
    ### Reverse the order of whitespace-separated words in a string.
  """
  in (s Str (doc "The input string whose words will be reversed"))
  out (r Str (doc "`s` with its words in reverse order, single-space separated"))
  examples """
    - `(reverse_words "hello world foo")` → `"foo world hello"`
    - `(reverse_words "a b c")` → `"c b a"`
  """
  engine python
  src "words = s.split()\nwords.reverse()\nreturn \" \".join(words)"
}
