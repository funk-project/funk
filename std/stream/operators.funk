; funk/std — stream operators DEFINED IN FUNK. With reactive nodes (docs/07) a
; scalar function applied to a stream fires per item, so `map` is simply `(f xs)`
; — the lift is the engine's firing, not a hand-written loop. `filter` needs a
; conditional emit, so it uses the minimal each/yield primitive (the "define your
; own operator" escape hatch). Sources like nats and the cancelling `take` stay
; in Go — the irreducible reactive plumbing.

package "funk/std/stream" {
  version 0.0.1
  use "funk/std/collections" as collections
  use "funk/std/maths" as maths
}

fn map {
  doc "apply f to each item of a stream — the reactive lift (docs/07 §5)"
  in  (xs Stream) (f Fn)
  out (r Stream)
  body (f xs)
}

fn filter {
  doc "keep items where f is true (defined in funk)"
  in  (xs Stream) (f Fn)
  out (r Stream)
  body
    (each xs (item)
      (if (f item)
        (yield item)))
}

fn mapSum {
  doc "sum of doubles of 1..n via the funk-defined map"
  in  (n Num)
  out (r Num)
  body
    (flush (r (collections.sum (collect (map (range 1 n) maths.double)))))
  test (is (mapSum 4) 20)
}

fn filterCount {
  doc "how many even numbers in 1..n via the funk-defined filter"
  in  (n Num)
  out (r Num)
  body
    (flush (r (collections.count (collect (filter (range 1 n) maths.even?)))))
  test (is (filterCount 10) 5)
}
