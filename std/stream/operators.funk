; funk/std — stream operators DEFINED IN FUNK. With reactive nodes (docs/07) a
; scalar function applied to a stream fires per item, so `map` is simply `(f xs)`
; — the lift is the engine's firing, not a hand-written loop. `filter` needs a
; conditional emit, so it uses the minimal each/yield primitive (the "define your
; own operator" escape hatch). Sources like nats and the cancelling `take` stay
; in Go — the irreducible reactive plumbing.

package "funk/std/stream" {
  version 0.0.1
  use "funk/std/collections" as collections
  use "funk/std/maths" as maths
}

fn map {
  name "Map"
  doc """
    # Map
    ### Apply `f` to every item of a stream, producing a new stream.
  """
  in  (xs Stream (doc "The input stream"))
      (f Fn (doc "The function applied to each item (any arity — a scalar or a whole List)"))
  out (r Stream (doc "A stream of the results of `f` applied to each item"))
  examples """
    - `(map (range 1 3) maths.double)` → stream `2, 4, 6`
    - `(map (range 1 4) maths.inc)` → stream `2, 3, 4, 5`
  """
  body
    (each xs (item)
      (yield (f item)))
}

fn filter {
  name "Filter"
  doc """
    # Filter
    ### Keep only the stream items for which `f` returns true, defined in funk via `each`/`yield`.
  """
  in  (xs Stream (doc "The input stream"))
      (f Fn (doc "The predicate tested on each item"))
  out (r Stream (doc "A stream of the items that satisfy `f`"))
  examples """
    - `(filter (range 1 4) maths.even?)` → stream `2, 4`
    - `(filter (range 1 6) maths.even?)` → stream `2, 4, 6`
  """
  body
    (each xs (item)
      (if (f item)
        (yield item)))
}

fn mapSum {
  name "Map Sum"
  doc """
    # Map Sum
    ### Sum of the doubles of `1..n`, computed with the funk-defined `map`.
  """
  in  (n Num (doc "The inclusive upper bound of the range `1..n`"))
  out (r Num (doc "The sum of `2·k` for each `k` in `1..n`"))
  examples """
    - `(mapSum 4)` → `20`
    - `(mapSum 3)` → `12`
  """
  body
    (flush (r (collections.sum (collect (map (range 1 n) maths.double)))))
  test (is (mapSum 4) 20)
}

fn filterCount {
  name "Filter Count"
  doc """
    # Filter Count
    ### Count of the even numbers in `1..n`, computed with the funk-defined `filter`.
  """
  in  (n Num (doc "The inclusive upper bound of the range `1..n`"))
  out (r Num (doc "How many numbers in `1..n` are even"))
  examples """
    - `(filterCount 10)` → `5`
    - `(filterCount 5)` → `2`
  """
  body
    (flush (r (collections.count (collect (filter (range 1 n) maths.even?)))))
  test (is (filterCount 10) 5)
}
