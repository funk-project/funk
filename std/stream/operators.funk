; funk/std — stream operators DEFINED IN FUNK, over the minimal each/yield
; primitive. map and filter are no longer Go core forms — they are readable,
; introspectable funk artifacts the agent can reason about and improve. The Go
; kernel shrinks; the notation defines its own vocabulary. (Sources like nats and
; the cancelling `take` stay in Go — the irreducible reactive plumbing.)

package "funk/std/stream" {
  version 0.0.1
}

fn map {
  doc "apply f to each item of a stream (defined in funk)"
  in  (xs Stream) (f Fn)
  out (r Stream)
  body
    (each xs (item)
      (yield (f item)))
}

fn filter {
  doc "keep items where f is true (defined in funk)"
  in  (xs Stream) (f Fn)
  out (r Stream)
  body
    (each xs (item)
      (if (f item)
        (yield item)))
}

fn mapSum {
  doc "sum of doubles of 1..n via the funk-defined map"
  in  (n Num)
  out (r Num)
  body
    (return (sum (collect (map (range 1 n) double))))
  test (is (mapSum 4) 20)
}

fn filterCount {
  doc "how many even numbers in 1..n via the funk-defined filter"
  in  (n Num)
  out (r Num)
  body
    (return (count (collect (filter (range 1 n) even?))))
  test (is (filterCount 10) 5)
}
