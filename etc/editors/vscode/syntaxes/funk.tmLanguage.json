{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "funk",
  "scopeName": "source.funk",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string-triple" },
    { "include": "#string" },
    { "include": "#block-head" },
    { "include": "#number" },
    { "include": "#field" },
    { "include": "#control" },
    { "include": "#reactive" },
    { "include": "#spec" },
    { "include": "#window-mod" },
    { "include": "#qualified" },
    { "include": "#type" },
    { "include": "#engine" },
    { "include": "#boolean" }
  ],
  "repository": {
    "comment": {
      "match": ";.*$",
      "name": "comment.line.semicolon.funk"
    },
    "string-triple": {
      "comment": "triple-quoted multi-line string (markdown docs); content is raw",
      "name": "string.quoted.triple.funk",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "contentName": "meta.embedded.block.markdown",
      "patterns": [
        { "include": "text.html.markdown" }
      ]
    },
    "string": {
      "name": "string.quoted.double.funk",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.funk" }
      ]
    },
    "number": {
      "match": "(?<![\\w.])-?\\d+(\\.\\d+)?(?![\\w.])",
      "name": "constant.numeric.funk"
    },
    "block-head": {
      "match": "\\b(fn|type)\\s+([A-Za-z_][\\w?!.-]*)",
      "captures": {
        "1": { "name": "storage.type.funk" },
        "2": { "name": "entity.name.function.funk" }
      }
    },
    "field": {
      "comment": "field heads inside an fn / type / package block",
      "match": "\\b(package|version|name|doc|examples|main|alias|in|out|engine|src|body|test|needs|effects|requires|import|use|as)\\b",
      "name": "keyword.other.funk"
    },
    "control": {
      "comment": "the composite core forms",
      "match": "\\b(do|let|if|while|for-each|on-error|retry|with|set|flush|return|exit|break|continue|is)\\b",
      "name": "keyword.control.funk"
    },
    "reactive": {
      "comment": "stream sources, operators and the each/yield primitive",
      "match": "\\b(range|nats|tick|repeat|map|filter|scan|fold|merge|take|collect|window|each|yield)\\b",
      "name": "support.function.builtin.funk"
    },
    "spec": {
      "comment": "port specs inside (name Type spec…)",
      "match": "(?<=\\()(min|max|default|zip|latest)\\b",
      "name": "support.function.builtin.funk"
    },
    "window-mod": {
      "comment": "window modifier keywords: (window xs 5s every 2s by field lateness 1s)",
      "match": "\\b(every|by|lateness)\\b",
      "name": "keyword.other.funk"
    },
    "qualified": {
      "comment": "the alias in a qualified cross-package call (use … as): (alias.fn …)",
      "match": "(?<=\\()([A-Za-z_][\\w-]*)(?=\\.)",
      "name": "entity.name.namespace.funk"
    },
    "type": {
      "match": "\\b(Num|Str|Bool|List|Json|Time|Bytes|Any|Stream|Fn)\\b",
      "name": "support.type.funk"
    },
    "engine": {
      "match": "\\b(builtin|python|go|claude|codex)\\b",
      "name": "support.constant.funk"
    },
    "boolean": {
      "match": "\\b(true|false|null|nil)\\b",
      "name": "constant.language.funk"
    }
  }
}
